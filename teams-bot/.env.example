# Copy this file to .env on the Windows PC and fill in real values.
# Never commit the real .env file.

# From the Azure Bot resource's app registration (Azure Portal > App registrations)
BOT_APP_ID=
BOT_APP_PASSWORD=

# Must match the REMINDER_WEBHOOK_SECRET GitHub repo secret exactly
REMINDER_WEBHOOK_SECRET=

# Local port the Flask service listens on (Cloudflare Tunnel points here)
PORT=3978
